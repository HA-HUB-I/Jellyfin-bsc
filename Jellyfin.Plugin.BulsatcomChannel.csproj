<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0</TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RootNamespace>Jellyfin.Plugin.BulsatcomChannel</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.BulsatcomChannel</AssemblyName>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>1.2.6.0</AssemblyVersion>
    <FileVersion>1.2.6.0</FileVersion>
    <Version>1.2.6</Version>
    <InformationalVersion>1.2.6</InformationalVersion>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.*-*" IncludeAssets="compile" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.*-*" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*-*" IncludeAssets="compile" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.*-*" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\*.html" />
    <None Remove="Configuration\*.js" />
    <EmbeddedResource Include="Configuration\*.html" />
    <EmbeddedResource Include="Configuration\*.js" />
  </ItemGroup>

</Project>
